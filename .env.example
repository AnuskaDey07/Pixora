# ─────────────────────────────────────────────────────────────
# Pixora — environment template
# Copy to .env and adjust. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
JWT_SECRET_KEY=change-me-too-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14
API_HOST_PORT=5000

# --- Postgres ---
POSTGRES_USER=pixora
POSTGRES_PASSWORD=pixora_dev_pw
POSTGRES_DB=pixora
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://pixora:pixora_dev_pw@postgres:5432/pixora

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=pixora
MINIO_ROOT_PASSWORD=pixora_dev_minio
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_UPLOADS=pixora-uploads
S3_BUCKET_THUMBS=pixora-thumbs
S3_BUCKET_RESULTS=pixora-results
S3_BUCKET_MASKS=pixora-masks

# --- Nginx ---
NGINX_HTTP_PORT=80

# --- Uploads ---
MAX_CONTENT_LENGTH_MB=50
ALLOWED_IMAGE_MIMES=image/png,image/jpeg,image/webp

# --- ML ---
ML_STUB_MODE=true