# Normalize all text files to LF on commit, regardless of platform
* text=auto eol=lf

# Explicit LF for scripts and configs
*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.py        text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.conf      text eol=lf

# Binary files — never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.pdf       binary
*.ipynb     binary

# Lockfiles — treat as generated
package-lock.json  linguist-generated=true